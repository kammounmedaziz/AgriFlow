<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestions.ferme.controllers.WindowAvisReclamationsController"
            stylesheets="@feedback.css"
            prefHeight="600" prefWidth="1000">

    <top>
        <HBox styleClass="header" prefHeight="80" alignment="CENTER" spacing="20">
            <ImageView fitHeight="60" fitWidth="60" styleClass="logo">
                <Image url="@/images/agriflow-logo-white.png" />
            </ImageView>
            <Label text="AVIS et RECLAMATIONS" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button styleClass="back-button" text="Retour"  >
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">

                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </top>


    <center>
        <VBox alignment="CENTER" spacing="40" styleClass="content-container">
            <VBox styleClass="feedback-section" spacing="15">
                <Label text="VOS RETOURS" styleClass="section-title"/>
                <ListView fx:id="feedbackList" styleClass="feedback-list">
                    <placeholder>
                        <Label text="Aucun retour pour le moment" styleClass="placeholder-text"/>
                    </placeholder>
                </ListView>
            </VBox>

            <HBox alignment="CENTER" spacing="30">
                <Button text="Ajouter un Avis" styleClass="action-button"  >
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20">

                        </ImageView>
                    </graphic>
                </Button>
                <Button text="Faire une Réclamation" styleClass="complaint-button"  >
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20">

                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </center>


</BorderPane>