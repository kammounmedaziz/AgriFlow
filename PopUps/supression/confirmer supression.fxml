<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane fx:id="popupRoot" prefHeight="250" prefWidth="400" stylesheets="confirmer supression.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">



    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10" stylesheets="@confirmer%20supression.css" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">
        <ImageView fitHeight="30" fitWidth="30" styleClass="warning-icon">
            <!-- <Image url="@/images/warning-icon.png"/> -->
        </ImageView>
        <Label styleClass="popup-title" text="Confirmation de suppression" />
      <styleClass>
         <String fx:value="popup-header" />
         <String fx:value="button-container" />
         <String fx:value="cancel-btn" />
         <String fx:value="confirm-btn" />
         <String fx:value="delete-popup" />
         <String fx:value="popup-background" />
         <String fx:value="popup-header" />
         <String fx:value="popup-message" />
         <String fx:value="popup-message" />
      </styleClass>
    </HBox>

    <!-- Content -->
    <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="80" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="70">
        <Label styleClass="popup-message" stylesheets="@confirmer%20supression.css" text="Êtes-vous sûr de vouloir supprimer cet élément ?" textFill="WHITE" />
        <Label styleClass="popup-warning" stylesheets="@confirmer%20supression.css" text="Cette action est irréversible." textFill="WHITE" />
    </VBox>

    <!-- Buttons -->
    <HBox alignment="CENTER" spacing="20" styleClass="button-container" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <Button onAction="#handleCancel" styleClass="cancel-btn" stylesheets="@confirmer%20supression.css" text="Annuler" />
        <Button onAction="#handleConfirm" styleClass="confirm-btn" stylesheets="@confirmer%20supression.css" text="Supprimer" />
    </HBox>
</AnchorPane>
